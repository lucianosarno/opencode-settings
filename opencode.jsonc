{
  "$schema": "https://opencode.ai/config.json",
  // Migrado de ~/.cursor (regras .mdc alwaysApply) e ~/.cursor/cli-config.json.
  // Regras sempre ativas: ~/.config/opencode/rules/*.md
  // Skills: ~/.config/opencode/skills/* (inclui as 8 skills vindas de ~/.cursor/skills)
  "instructions": [
    "C:/Users/LucianoSoares/.config/opencode/rules/always-commit-work.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/ask-for-permission.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/care-git-flow.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/completed-only-when-tested.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/dont-assume-jargon.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/dual-architecture-practical.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/easy-to-run.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/expose-settings.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/fluent-readable-prose.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/git-graph-no-loose-tips.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/no-hard-wrap-markdown.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/persistent-logs.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/pr-markdown-task-lists.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/response-hierarchy.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/shell-usage-policy.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/test-and-check-before-done.md",
    // Regras por projeto: carrega as .mdc/.md de .cursor/rules do repo atual (fonte única Cursor+opencode).
    // Resolvido contra a raiz do projeto (globUp do cwd até a worktree) — vale para qualquer repo.
    ".cursor/rules/*.mdc",
    ".cursor/rules/*.md",
    ".cursor/rules/**/*.mdc",
    ".cursor/rules/**/*.md"
  ],
  // Modo build com autonomia dentro do repo.
  // Regra: a ULTIMA regra que casa vence. Por isso "*": "allow" vem primeiro e as excecoes
  // "ask" vem depois. Shell e pedido de aprovacao apenas para: (a) caminhos absolutos ou
  // relativos para fora do repo, (b) remocao/movimentacao destrutiva, (c) push/reset/config
  // do git, (d) rede e instalacoes globais, (e) alteracoes no sistema operacional.
  // Limitacao: e checagem por texto do comando, nao sandbox. Acesso de arquivo por
  // read/edit/glob/grep fora do repo continua controlado por "external_directory".
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "bash": {
      "*": "allow",
      // Caminhos absolutos (qualquer drive) e saidas do repo.
      "*C:/*": "ask",
      "*C:\\*": "ask",
      "*c:/*": "ask",
      "*c:\\*": "ask",
      "*/home/*": "ask",
      "*~*": "ask",
      "*..*": "ask",
      "*$env:*": "ask",
      "*$HOME*": "ask",
      "*%USERPROFILE%*": "ask",
      "*%APPDATA%*": "ask",
      // Remocao e movimentacao destrutiva.
      "rm *": "ask",
      "rm": "ask",
      "rmdir*": "ask",
      "rd *": "ask",
      "del *": "ask",
      "erase *": "ask",
      "Remove-Item*": "ask",
      "mv *": "ask",
      "Move-Item*": "ask",
      "git clean*": "ask",
      "git reset --hard*": "ask",
      "git branch -d*": "ask",
      "git branch -D*": "ask",
      "git stash drop*": "ask",
      "git stash clear*": "ask",
      // Git com efeito remoto ou em configuracao.
      "git push*": "ask",
      "git config*": "ask",
      "git remote*": "ask",
      "gh *": "ask",
      // Rede e instalacoes.
      "curl*": "ask",
      "wget*": "ask",
      "Invoke-WebRequest*": "ask",
      "Invoke-RestMethod*": "ask",
      "npm install -g*": "ask",
      "npm i -g*": "ask",
      "npm install --global*": "ask",
      "pip install*": "ask",
      "winget*": "ask",
      "choco*": "ask",
      // Sistema operacional.
      "reg *": "ask",
      "setx*": "ask",
      "schtasks*": "ask",
      "Start-Process*": "ask",
      "Stop-Process*": "ask",
      "Set-ItemProperty*": "ask",
      "sudo*": "ask"
    },
    "shell": {
      "*": "allow",
      "*C:/*": "ask",
      "*C:\\*": "ask",
      "*c:/*": "ask",
      "*c:\\*": "ask",
      "*/home/*": "ask",
      "*~*": "ask",
      "*..*": "ask",
      "*$env:*": "ask",
      "*$HOME*": "ask",
      "*%USERPROFILE%*": "ask",
      "*%APPDATA%*": "ask",
      "rm *": "ask",
      "rm": "ask",
      "rmdir*": "ask",
      "rd *": "ask",
      "del *": "ask",
      "erase *": "ask",
      "Remove-Item*": "ask",
      "mv *": "ask",
      "Move-Item*": "ask",
      "git clean*": "ask",
      "git reset --hard*": "ask",
      "git branch -d*": "ask",
      "git branch -D*": "ask",
      "git stash drop*": "ask",
      "git stash clear*": "ask",
      "git push*": "ask",
      "git config*": "ask",
      "git remote*": "ask",
      "gh *": "ask",
      "curl*": "ask",
      "wget*": "ask",
      "Invoke-WebRequest*": "ask",
      "Invoke-RestMethod*": "ask",
      "npm install -g*": "ask",
      "npm i -g*": "ask",
      "npm install --global*": "ask",
      "pip install*": "ask",
      "winget*": "ask",
      "choco*": "ask",
      "reg *": "ask",
      "setx*": "ask",
      "schtasks*": "ask",
      "Start-Process*": "ask",
      "Stop-Process*": "ask",
      "Set-ItemProperty*": "ask",
      "sudo*": "ask"
    },
    "websearch": "ask",
    "webfetch": "ask",
    // Leitura do repositorio de peer review (process/, standards, dominios) fora do projeto atual.
    // Escopo restrito: so esta arvore. Demais caminhos externos continuam em "ask".
    "external_directory": {
      "*": "ask",
      "C:/Users/LucianoSoares/Projects/llms_peer_review/**": "allow",
      "C:\\Users\\LucianoSoares\\Projects\\llms_peer_review\\**": "allow"
    }
  },
  // Overrides por agente. O build NAO tem override: herda o "permission" global (edit liberado
  // dentro do repo; shell liberado exceto os casos "ask" acima; caminhos externos pedem aprovacao).
  // O explore e somente leitura: nao edita e nao executa shell.
  "agent": {
    "explore": {
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "shell": "deny"
      }
    },
    "plan": {
      "permission": {
        "edit": {
          "*": "deny",
          ".opencode/plans/*.md": "allow",
          "~/.local/share/opencode/plans/*": "allow",
          "~/.opencode/plan/*": "allow"
        },
        "bash": {
          "*": "deny",
          "ls*": "allow",
          "git status*": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "git show*": "allow"
        },
        "shell": {
          "*": "deny",
          "ls*": "allow",
          "git status*": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "git show*": "allow"
        },
        "task": "deny"
      }
    }
  },
  // Equivalente a cli-config.json "rewind": true (undo/revert de edições).
  "snapshot": true
}
