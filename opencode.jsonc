{
  "$schema": "https://opencode.ai/config.json",
  // Migrado de ~/.cursor (regras .mdc alwaysApply) e ~/.cursor/cli-config.json.
  // Regras sempre ativas: ~/.config/opencode/rules/*.md
  // Skills: ~/.config/opencode/skills/* (inclui as 8 skills vindas de ~/.cursor/skills)
  "instructions": [
    "C:/Users/LucianoSoares/.config/opencode/rules/always-commit-work.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/ask-for-permission.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/care-git-flow.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/completed-only-when-tested.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/dont-assume-jargon.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/dual-architecture-practical.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/easy-to-run.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/expose-settings.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/fluent-readable-prose.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/git-graph-no-loose-tips.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/no-hard-wrap-markdown.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/persistent-logs.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/pr-markdown-task-lists.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/response-hierarchy.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/shell-usage-policy.md",
    "C:/Users/LucianoSoares/.config/opencode/rules/test-and-check-before-done.md",
    // Regras por projeto: carrega as .mdc/.md de .cursor/rules do repo atual (fonte única Cursor+opencode).
    // Resolvido contra a raiz do projeto (globUp do cwd até a worktree) — vale para qualquer repo.
    ".cursor/rules/*.mdc",
    ".cursor/rules/*.md",
    ".cursor/rules/**/*.mdc",
    ".cursor/rules/**/*.md"
  ],
  // Paridade com os modos do Cursor (ver ~/.cursor/cli-config.json e docs do Cursor):
  //   build = Agent  : edita e executa comandos sem pedir; pede aprovacao so para o risco real.
  //   plan  = Plan   : pesquisa e escreve apenas o plano (.opencode/plans); shell so leitura.
  //   ask   = Ask    : somente leitura, sem edicao; shell so leitura.
  // Regra do opencode: a ULTIMA regra que casa vence. "*" fica primeiro e as excecoes depois.
  // Caminhos fora do projeto nao sao filtrados por texto de comando: isso e feito por
  // "external_directory" (o opencode pede aprovacao quando uma ferramenta toca fora do projeto).
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "bash": {
      "*": "allow",
      // Remocao e movimentacao destrutiva.
      "rm *": "ask",
      "rm": "ask",
      "rmdir*": "ask",
      "rd *": "ask",
      "del *": "ask",
      "erase *": "ask",
      "Remove-Item*": "ask",
      "mv *": "ask",
      "Move-Item*": "ask",
      "git clean*": "ask",
      "git reset --hard*": "ask",
      "git branch -d*": "ask",
      "git branch -D*": "ask",
      "git stash drop*": "ask",
      "git stash clear*": "ask",
      // Git com efeito remoto ou em configuracao.
      "git push*": "ask",
      "git config*": "ask",
      "git remote*": "ask",
      "gh *": "ask",
      // Rede e instalacoes globais.
      "curl*": "ask",
      "wget*": "ask",
      "Invoke-WebRequest*": "ask",
      "Invoke-RestMethod*": "ask",
      "npm install -g*": "ask",
      "npm i -g*": "ask",
      "npm install --global*": "ask",
      "pip install*": "ask",
      "winget*": "ask",
      "choco*": "ask",
      // Sistema operacional.
      "reg *": "ask",
      "setx*": "ask",
      "schtasks*": "ask",
      "Start-Process*": "ask",
      "Stop-Process*": "ask",
      "Set-ItemProperty*": "ask",
      "sudo*": "ask"
    },
    "shell": {
      "*": "allow",
      "rm *": "ask",
      "rm": "ask",
      "rmdir*": "ask",
      "rd *": "ask",
      "del *": "ask",
      "erase *": "ask",
      "Remove-Item*": "ask",
      "mv *": "ask",
      "Move-Item*": "ask",
      "git clean*": "ask",
      "git reset --hard*": "ask",
      "git branch -d*": "ask",
      "git branch -D*": "ask",
      "git stash drop*": "ask",
      "git stash clear*": "ask",
      "git push*": "ask",
      "git config*": "ask",
      "git remote*": "ask",
      "gh *": "ask",
      "curl*": "ask",
      "wget*": "ask",
      "Invoke-WebRequest*": "ask",
      "Invoke-RestMethod*": "ask",
      "npm install -g*": "ask",
      "npm i -g*": "ask",
      "npm install --global*": "ask",
      "pip install*": "ask",
      "winget*": "ask",
      "choco*": "ask",
      "reg *": "ask",
      "setx*": "ask",
      "schtasks*": "ask",
      "Start-Process*": "ask",
      "Stop-Process*": "ask",
      "Set-ItemProperty*": "ask",
      "sudo*": "ask"
    },
    "websearch": "ask",
    "webfetch": "ask",
    // Leitura do repositorio de peer review (process/, standards, dominios) fora do projeto atual.
    // Escopo restrito: so esta arvore. Demais caminhos externos continuam em "ask".
    "external_directory": {
      "*": "ask",
      "C:/Users/LucianoSoares/Projects/llms_peer_review/**": "allow",
      "C:\\Users\\LucianoSoares\\Projects\\llms_peer_review\\**": "allow"
    }
  },
  "agent": {
    // Build (= Agent do Cursor): sem override, herda o "permission" global acima.
    // Plan (= Plan do Cursor): so escreve o plano; pesquisa com leitura, subagentes e shell de leitura.
    "plan": {
      "permission": {
        "edit": {
          "*": "deny",
          ".opencode/plans/*.md": "allow",
          "~/.local/share/opencode/plans/*": "allow",
          "~/.opencode/plan/*": "allow"
        },
        "bash": {
          "*": "ask",
          "ls*": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "rg *": "allow",
          "Get-Content*": "allow",
          "Get-ChildItem*": "allow",
          "Get-Item*": "allow",
          "Get-Location*": "allow",
          "Test-Path*": "allow",
          "Select-Object*": "allow",
          "Where-Object*": "allow",
          "ForEach-Object*": "allow",
          "Sort-Object*": "allow",
          "Format-Table*": "allow",
          "Out-String*": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow"
        },
        "shell": {
          "*": "ask",
          "ls*": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "rg *": "allow",
          "Get-Content*": "allow",
          "Get-ChildItem*": "allow",
          "Get-Item*": "allow",
          "Get-Location*": "allow",
          "Test-Path*": "allow",
          "Select-Object*": "allow",
          "Where-Object*": "allow",
          "ForEach-Object*": "allow",
          "Sort-Object*": "allow",
          "Format-Table*": "allow",
          "Out-String*": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow"
        },
        "task": "allow"
      }
    },
    // Ask (= Ask do Cursor): somente leitura. Nao edita; shell so de leitura.
    "ask": {
      "mode": "primary",
      "description": "Responde perguntas sobre o codigo sem editar arquivos (equivalente ao Ask do Cursor).",
      "prompt": "Voce esta no modo Ask: responda perguntas e explique o codigo. Nao edite arquivos e nao execute comandos que alterem o estado do projeto.",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "ls*": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "rg *": "allow",
          "Get-Content*": "allow",
          "Get-ChildItem*": "allow",
          "Get-Item*": "allow",
          "Get-Location*": "allow",
          "Test-Path*": "allow",
          "Select-Object*": "allow",
          "Where-Object*": "allow",
          "ForEach-Object*": "allow",
          "Sort-Object*": "allow",
          "Format-Table*": "allow",
          "Out-String*": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow"
        },
        "shell": {
          "*": "ask",
          "ls*": "allow",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "rg *": "allow",
          "Get-Content*": "allow",
          "Get-ChildItem*": "allow",
          "Get-Item*": "allow",
          "Get-Location*": "allow",
          "Test-Path*": "allow",
          "Select-Object*": "allow",
          "Where-Object*": "allow",
          "ForEach-Object*": "allow",
          "Sort-Object*": "allow",
          "Format-Table*": "allow",
          "Out-String*": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow"
        },
        "task": "allow"
      }
    },
    // Explore: subagente somente leitura usado pelo build/plan. Nao edita e nao executa shell.
    "explore": {
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "shell": "deny"
      }
    }
  },
  // Provider Tencent TokenHub (chaves sk-... de console.cloud.tencent.com/tokenhub/apikey, cobranca por uso).
  // Regiao Guangzhou = https://tokenhub.tencentmaas.com/v1 (API OpenAI-compativel). Model ID em minusculas: hy3.
  // A chave NAO fica no arquivo: defina a variavel de ambiente TENCENT_TOKENHUB_API_KEY.
  // Chaves sk-tp-... (Token Plan) usam outro endpoint (/plan/v3) e outro provider; nao misture.
  "provider": {
    "tencent": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Tencent TokenHub (Guangzhou)",
      "options": {
        "baseURL": "https://tokenhub.tencentmaas.com/v1",
        "apiKey": "{env:TENCENT_TOKENHUB_API_KEY}"
      },
      "models": {
        "hy3": {
          "name": "Hy3",
          "modalities": { "input": ["text"], "output": ["text"] }
        }
      }
    }
  },
  // Equivalente a cli-config.json "rewind": true (undo/revert de edições).
  "snapshot": true
}
